# === 飞书多维表格配置 ===
# 在飞书开放平台创建企业自建应用后获取 https://open.feishu.cn/app 
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

#飞书多维表格 URL https://xxx.feishu.cn/base/appToken?table=tblId 中可看到。
FEISHU_APP_TOKEN=你的多维表格 appToken
FEISHU_TABLE_ID=你的多维表格 tableId

# === LLM 供应商配置 ===
# 当前使用的供应商 (deepseek | openai | anthropic | ollama)
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Ollama (本地部署)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# === 简历信息 ===
# BOSS 直聘在线简历 UID（在简历页 URL 中可找到）
BOSS_RESUME_UID=

# === 浏览器配置 ===
# Chromium 浏览器路径，留空则使用 Playwright 内置
# CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ====== 评分阈值配置 ======
# search --write 命令使用：LLM 评分 >= 阈值 才写入飞书
# 范围 0~1，越界或非数字会启动失败，默认值为 0.85
SCORE_THRESHOLD=0.85