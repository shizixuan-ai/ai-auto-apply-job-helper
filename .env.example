  # === 飞书多维表格配置 ===
  FEISHU_APP_ID=cli_xxxxxxxxxxxx
  FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx
  FEISHU_APP_TOKEN=你的多维表格 appToken
  FEISHU_TABLE_ID=你的多维表格 tableId

  # === LLM 供应商配置 (Sprint 1D / ADR-0011) ===
  # 协议选择（可选值: anthropic | openai；缺失默认 anthropic）
  LLM_ADAPTER=anthropic
  # 鉴权方式（仅 anthropic 协议用，可选值: bearer | x-api-key缺失默认 bearer）
  LLM_AUTH_STYLE=bearer
  # deepseek(default) | openai | anthropic | ollama | minimax | huoshan
  LLM_PROVIDER=deepseek

  # === 通用 LLM 配置 (Sprint 1D 新增) ===
  LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
  # LLM_BASE_URL=
  # LLM_MODEL=


  # === 浏览器配置 ===
  # CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

  # ====== 评分阈值配置 =====
  SCORE_THRESHOLD=0.85
  MIN_JD_LENGTH_THRESHOLD=300