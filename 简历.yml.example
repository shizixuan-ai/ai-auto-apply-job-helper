# ============================================================
# 简历模板 — 新用户复制此文件改名为 简历.yml
# ============================================================
# 字段说明：
#   - 必填字段（# required）：基础信息.姓名、是否985_211、工作经历.工作年限、
#                            工作经历.是否大厂背景、技能清单
#   - 其余字段 optional：缺省不抛错，仅在 IncompleteResumeError 时列出缺失项
#   - 推断字段（是否985_211 / 是否大厂背景）：候选人最清楚自己，不要让代码推
#   - 数组字段（技能清单 / 工作经历.经历）：支持 YAML 列表语法
#   - 多行字段（自我介绍）：用 | 块或 > 折叠块
#
# 校验库：Zod schema (src/resume/yaml-parser.ts)
# 错误类型：
#   - ResumeNotFoundError：文件不存在
#   - IncompleteResumeError：缺必填字段
#   - ResumeParseError：YAML 语法错或 schema 校验失败
# ============================================================

# ---------- 基础信息 ----------
基础信息:
  姓名: 你的姓名              # required
  性别: 男                    # optional（男/女/未知）
  年龄: 30                    # optional（正整数）
  手机号: ""                  # optional
  邮箱: ""                    # optional

# ---------- 求职意向 ----------
求职意向:
  目标岗位: Java 后端开发      # optional（不填则由 buildResumeSummary 启发式派生）

# ---------- 学历背景（optional block）----------
教育背景:
  毕业院校: 你的毕业院校        # optional
  学历层次: 本科                # optional（本科/硕士/博士/其他）
  专业名称: 计算机科学与技术     # optional

# ---------- 是否 985/211（顶层必填 boolean）----------
#   不知道是哪个？查教育部名单 2022 公示版（139 所）
#   985 = 39 所；211 = 116 所（含 985）
#   不是任何一所 → false
是否985_211: false

# ---------- 工作经历（required block）----------
工作经历:
  工作年限: 5                  # required
  # Top 公司名单：阿里 / 腾讯 / 字节 / 美团 / 京东 / 华为 / 拼多多 / 网易 / 滴滴 / 小米
  # 任意一段经历命中 → true
  是否大厂背景: false           # required
  经历:                        # optional array of objects
    - 公司: 你的公司 A
      时间段: "2023.01-2024.06"
      职位: 后端工程师
      描述: "项目描述（技术栈 + 量化成果）"
    - 公司: 你的公司 B
      时间段: "2021.06-2022.12"
      职位: 高级开发
      描述: "项目描述"

# ---------- 技能清单（required, min 1）----------
技能清单:                       # required
  - Java
  - Spring
  - MySQL

# ---------- 自我介绍（optional 多行块）----------
自我介绍: |
  N 年 XX 方向开发经验，专注 XX / XX。
  主导过 XX 量级系统。
